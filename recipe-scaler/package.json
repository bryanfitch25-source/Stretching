{
  "name": "yield-recipe-scaler",
  "version": "1.0.0",
  "description": "Yield — a local-only recipe scaling app for Android (Capacitor).",
  "private": true,
  "scripts": {
    "start": "npx http-server www -p 8100 -c-1",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "http-server": "^14.1.1"
  }
}
